# Normalise all line endings to LF in the repo, check out as CRLF on Windows
* text=auto

# Force LF for code files (important for cross-platform consistency)
*.cs    text eol=lf
*.csproj text eol=lf
*.slnx  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Binaries — no newline processing
*.db    binary
*.dll   binary
*.exe   binary
*.png   binary
*.jpg   binary
